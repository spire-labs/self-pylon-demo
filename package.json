{
  "name": "self-pylon-demo",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "contracts",
    "packages/*"
  ],
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@self-pylon-demo/abis": "workspace:*",
    "@self-pylon-demo/addresses": "workspace:*",
    "@self-pylon-demo/self-adapter": "workspace:*",
    "@selfxyz/contracts": "^1.2.1",
    "celo-self-contracts": "git+https://github.com/spire-labs/celo-self-contracts.git#3985267850577e847bac30129083b1dc962e8b41"
  },
  "scripts": {
    "build": "pnpm -r --filter frontend run build",
    "dev": "pnpm -r --filter frontend run dev",
    "lint": "pnpm -r --filter frontend run lint"
  }
}
