# Frontend Environment Variables
# 
# ⚠️  IMPORTANT: Copy this file to .env.local and fill in the values before building or running the frontend.
# The app will not work properly without these environment variables.
# 
# Required for:
# - Building the frontend (pnpm build)
# - Running the frontend locally (pnpm dev)
# - Deploying the frontend (./scripts/build-frontend.sh)

# Celo Mainnet Configuration (where attestations are stored)
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_CHAIN_ID=42220
NEXT_PUBLIC_PROOF_OF_HUMAN_ADDRESS=0x5E05a5CCf9fe3EC0a4b602A56381D685D0f711a8

# Self Protocol Configuration
NEXT_PUBLIC_SELF_SCOPE=self-pylon-demo

# Human Appchain Configuration (where NFT minting happens)
NEXT_PUBLIC_PYLON_RPC_URL=https://pylon.celo-mainnet.spire.dev/v1/chain/2139/rpc
NEXT_PUBLIC_PYLON_CHAIN_ID=2139
NEXT_PUBLIC_HUMAN_NFT_ADDRESS=0x51AF8BA13f0954f62b60EbB4167164caD7621aAE

# WalletConnect Configuration (required for wallet connections)
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional: Base Path for deployment (leave empty for custom domain, or set to /repo-name for GitHub Pages)
# NEXT_PUBLIC_BASE_PATH=

# Optional: Site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://human.spire.dev
